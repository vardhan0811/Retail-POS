# Local overrides (keep secrets out of git)
**/appsettings.Local.json
**/appsettings.*.Local.json
**/appsettings.Development.Local.json
**/*.Development.Local.json

# Build outputs
**/bin/
**/obj/

# Logs
**/Logs/

# User-specific files
*.user
*.suo
*.cache
*.log



# Ignore .github, .vs, and .vscode folders
.github/
.vs/
.vscode/

# Ignore Office temporary files (e.g. ~${filename}.docx)
~$*

