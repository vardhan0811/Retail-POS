using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using RabbitMQ.Client;
using RabbitMQ.Client.Events;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.DependencyInjection;
using Shared.Contracts;
using BillingService.Data;
using Microsoft.EntityFrameworkCore;

namespace BillingService.Services
{
    public class RabbitMqConsumerHostedService : RabbitMqConsumerBase
    {
        private readonly IServiceScopeFactory _scopeFactory;
        private readonly IConfiguration _config;
        public RabbitMqConsumerHostedService(IConfiguration config, ILogger<RabbitMqConsumerHostedService> logger, IServiceScopeFactory scopeFactory)
            : base(config, logger, queueName: "stock.reserved.from.product", routingKeys: "stock.reserved", "stock.failed")
        {
            _scopeFactory = scopeFactory;
            _config = config;
        }

        protected override async Task ProcessMessageAsync(byte[] body, string routingKey)
        {
            var message = Encoding.UTF8.GetString(body);
            using var scope = _scopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<BillingDbContext>();
            if (routingKey == "stock.reserved")
            {
                var evt = System.Text.Json.JsonSerializer.Deserialize<Shared.Contracts.Events.StockReservedEvent>(message, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (evt != null)
                {
                    var bill = await db.Bills.FirstOrDefaultAsync(b => b.Id == evt.BillId);
                    if (bill != null)
                    {
                        bill.Status = "Confirmed";
                        await db.SaveChangesAsync();
                    }
                }
            }
            else if (routingKey == "stock.failed")
            {
                var evt = System.Text.Json.JsonSerializer.Deserialize<Shared.Contracts.Events.StockFailedEvent>(message, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (evt != null)
                {
                    var bill = await db.Bills.FirstOrDefaultAsync(b => b.Id == evt.BillId);
                    if (bill != null)
                    {
                        bill.Status = "Failed";
                        await db.SaveChangesAsync();
                    }
                }
            }
        }
    }
}
