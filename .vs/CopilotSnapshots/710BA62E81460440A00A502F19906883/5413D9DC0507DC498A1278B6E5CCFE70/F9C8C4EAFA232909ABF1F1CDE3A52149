using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using RabbitMQ.Client;
using RabbitMQ.Client.Events;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.DependencyInjection;
using Shared.Contracts;
using ProductService.Data;
using ProductService.Entities;
using Microsoft.EntityFrameworkCore;

namespace ProductService.Services
{
    public class RabbitMqConsumerHostedService : RabbitMqConsumerBase
    {
        private readonly IServiceScopeFactory _scopeFactory;
        private readonly IConfiguration _config;
        public RabbitMqConsumerHostedService(IConfiguration config, ILogger<RabbitMqConsumerHostedService> logger, IServiceScopeFactory scopeFactory)
            : base(config, logger, queueName: "bill.created.from.billing", routingKeys: "bill.created")
        {
            _scopeFactory = scopeFactory;
            _config = config;
        }

        protected override async Task ProcessMessageAsync(byte[] body, string routingKey)
        {
            var message = Encoding.UTF8.GetString(body);
            var billEvent = System.Text.Json.JsonSerializer.Deserialize<BillCreatedEvent>(message);
            if (billEvent != null)
            {
                using var scope = _scopeFactory.CreateScope();
                var db = scope.ServiceProvider.GetRequiredService<ProductDbContext>();

                // Idempotency: check processed messages
                var already = await db.ProcessedMessages.AnyAsync(pm => pm.MessageId == billEvent.BillId);
                if (already)
                {
                    var logger = scope.ServiceProvider.GetRequiredService<ILogger<RabbitMqConsumerHostedService>>();
                    logger.LogInformation("Message already processed: {id}", billEvent.BillId);
                }
                else
                {
                    // Reserve stock for each item
                    var updates = new List<(Guid productId, int quantity)>();
                    var failed = false;
                    foreach (var item in billEvent.Items)
                    {
                        var product = await db.Products.FirstOrDefaultAsync(p => p.Id == item.ProductId && p.IsActive);
                        if (product == null || product.Stock < item.Quantity)
                        {
                            failed = true;
                            break;
                        }
                        updates.Add((item.ProductId, product.Stock - item.Quantity));
                    }

                    var publisher = scope.ServiceProvider.GetRequiredService<RabbitMqPublisherBase>();
                    if (failed)
                    {
                        // publish stock.failed
                        var evt = new StockFailedEvent { BillId = billEvent.BillId, Reason = "Insufficient stock" };
                        publisher.Publish(evt, "stock.failed");
                    }
                    else
                    {
                        // apply stock updates
                        foreach (var u in updates)
                        {
                            var product = await db.Products.FirstOrDefaultAsync(p => p.Id == u.productId && p.IsActive);
                            if (product != null)
                            {
                                product.Stock = u.quantity;
                            }
                        }
                        // mark processed
                        db.ProcessedMessages.Add(new ProcessedMessage { Id = Guid.NewGuid(), MessageId = billEvent.BillId, ProcessedAt = DateTime.UtcNow });
                        await db.SaveChangesAsync();

                        // publish stock.reserved
                        var evt = new StockReservedEvent { BillId = billEvent.BillId };
                        publisher.Publish(evt, "stock.reserved");
                    }
                }
            }
        }
    }
}
