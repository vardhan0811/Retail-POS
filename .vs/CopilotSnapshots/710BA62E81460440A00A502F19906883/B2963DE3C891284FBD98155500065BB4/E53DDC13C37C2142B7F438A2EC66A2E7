using Microsoft.Extensions.Hosting;
using RabbitMQ.Client;
using RabbitMQ.Client.Events;
using System.Text;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace NotificationService.Services
{
    public class RabbitMqConsumerHostedService : BackgroundService
    {
        private readonly IServiceScopeFactory _scopeFactory;
        private readonly ILogger<RabbitMqConsumerHostedService> _logger;
        private IConnection _connection;
        private IModel _channel;

        public RabbitMqConsumerHostedService(IServiceScopeFactory scopeFactory, ILogger<RabbitMqConsumerHostedService> logger)
        {
            _scopeFactory = scopeFactory;
            _logger = logger;
            var factory = new ConnectionFactory { HostName = "localhost", UserName = "guest", Password = "guest" };
            _connection = factory.CreateConnection();
            _channel = _connection.CreateModel();
        }

        protected override Task ExecuteAsync(CancellationToken stoppingToken)
        {
            // Listen to .from.* queues for notifications
            _channel.QueueDeclare("user.created.from.auth", durable: true, exclusive: false, autoDelete: false, arguments: null);
            _channel.QueueDeclare("bill.created.from.billing", durable: true, exclusive: false, autoDelete: false, arguments: null);
            _channel.QueueDeclare("stock.failed.from.product", durable: true, exclusive: false, autoDelete: false, arguments: null);
            _channel.QueueDeclare("stock.reserved.from.product", durable: true, exclusive: false, autoDelete: false, arguments: null);
            var consumer = new EventingBasicConsumer(_channel);
            consumer.Received += (model, ea) =>
            {
                var body = ea.Body.ToArray();
                var message = Encoding.UTF8.GetString(body);
                _logger.LogInformation("[NotificationService Consumer] Received from {queue}: {msg}", ea.RoutingKey, message);
                // Example: Deserialize and log CorrelationId for all events
                if (ea.RoutingKey == "user.created.from.auth")
                {
                    var evt = JsonSerializer.Deserialize<Shared.Contracts.UserCreatedEvent>(message);
                    if (evt != null)
                        _logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
                else if (ea.RoutingKey == "bill.created.from.billing")
                {
                    var evt = JsonSerializer.Deserialize<Shared.Contracts.BillCreatedEvent>(message);
                    if (evt != null)
                        _logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
                else if (ea.RoutingKey == "stock.failed.from.product")
                {
                    var evt = JsonSerializer.Deserialize<Shared.Contracts.StockFailedEvent>(message);
                    if (evt != null)
                        _logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
                else if (ea.RoutingKey == "stock.reserved.from.product")
                {
                    var evt = JsonSerializer.Deserialize<Shared.Contracts.StockReservedEvent>(message);
                    if (evt != null)
                        _logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
                // Here you would call OtpService or email/SMS logic as needed
                _channel.BasicAck(ea.DeliveryTag, false);
            };
            _channel.BasicConsume(queue: "user.created.from.auth", autoAck: false, consumer: consumer);
            _channel.BasicConsume(queue: "bill.created.from.billing", autoAck: false, consumer: consumer);
            _channel.BasicConsume(queue: "stock.failed.from.product", autoAck: false, consumer: consumer);
            _channel.BasicConsume(queue: "stock.reserved.from.product", autoAck: false, consumer: consumer);
            return Task.CompletedTask;
        }

        public override void Dispose()
        {
            _channel?.Dispose();
            _connection?.Dispose();
            base.Dispose();
        }
    }
}
