using Microsoft.Extensions.Hosting;
using RabbitMQ.Client;
using RabbitMQ.Client.Events;
using System.Text;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using AuthService.Events;
using AuthService.Data;
using AuthService.Entities;
using Microsoft.EntityFrameworkCore;

namespace AuthService.Services
{
    public class RabbitMqConsumerHostedService : BackgroundService
    {
        private readonly IServiceScopeFactory _scopeFactory;
        private readonly ILogger<RabbitMqConsumerHostedService> _logger;
        private IConnection _connection;
        private IModel _channel;

        public RabbitMqConsumerHostedService(IServiceScopeFactory scopeFactory, ILogger<RabbitMqConsumerHostedService> logger)
        {
            _scopeFactory = scopeFactory;
            _logger = logger;
            var factory = new ConnectionFactory { HostName = "localhost", UserName = "guest", Password = "guest" };
            _connection = factory.CreateConnection();
            _channel = _connection.CreateModel();
        }

        protected override Task ExecuteAsync(CancellationToken stoppingToken)
        {
            _channel.QueueDeclare("user.created", durable: true, exclusive: false, autoDelete: false, arguments: null);
            _channel.QueueDeclare("user.rolechanged", durable: true, exclusive: false, autoDelete: false, arguments: null);
            _channel.QueueDeclare("user.deactivated", durable: true, exclusive: false, autoDelete: false, arguments: null);
            _channel.QueueDeclare("user.activated", durable: true, exclusive: false, autoDelete: false, arguments: null);

            var consumer = new EventingBasicConsumer(_channel);
            consumer.Received += async (model, ea) =>
            {
                var body = ea.Body.ToArray();
                var message = Encoding.UTF8.GetString(body);
                _logger.LogInformation("[AuthService Consumer] Received from {queue}: {msg}", ea.RoutingKey, message);
                try
                {
                    using var scope = _scopeFactory.CreateScope();
                    var db = scope.ServiceProvider.GetRequiredService<AuthDbContext>();
                    if (ea.RoutingKey == "user.created")
                    {
                        var userEvent = JsonSerializer.Deserialize<UserCreatedEvent>(message);
                        if (userEvent != null)
                        {
                            var exists = await db.Users.AnyAsync(u => u.Email == userEvent.Email);
                            if (!exists)
                            {
                                var user = new User
                                {
                                    Id = userEvent.UserId,
                                    Email = userEvent.Email,
                                    Name = userEvent.Email,
                                    IsActive = true,
                                    CreatedAt = userEvent.CreatedAt,
                                    PasswordHash = userEvent.PasswordHash // Store password hash from event
                                };
                                db.Users.Add(user);
                                await db.SaveChangesAsync();
                                _logger.LogInformation("[AuthService] User added: {email}", user.Email);
                            }
                            else
                            {
                                _logger.LogInformation("[AuthService] User already exists: {email}", userEvent.Email);
                            }
                        }
                    }
                    else if (ea.RoutingKey == "user.rolechanged")
                    {
                        var evt = JsonSerializer.Deserialize<UserRoleChangedEvent>(message);
                        if (evt != null)
                        {
                            var user = await db.Users.FirstOrDefaultAsync(u => u.Id == evt.UserId);
                            if (user != null)
                            {
                                var newRole = await db.Roles.FirstOrDefaultAsync(r => r.Name == evt.NewRole);
                                if (newRole != null)
                                {
                                    user.RoleId = newRole.Id;
                                    await db.SaveChangesAsync();
                                    _logger.LogInformation("[AuthService] User role updated: {userId} to {role}", user.Id, evt.NewRole);
                                }
                            }
                        }
                    }
                    else if (ea.RoutingKey == "user.deactivated")
                    {
                        var evt = JsonSerializer.Deserialize<UserDeactivatedEvent>(message);
                        if (evt != null)
                        {
                            var user = await db.Users.FirstOrDefaultAsync(u => u.Id == evt.UserId);
                            if (user != null)
                            {
                                user.IsActive = false;
                                await db.SaveChangesAsync();
                                _logger.LogInformation("[AuthService] User deactivated: {userId}", user.Id);
                            }
                        }
                    }
                    else if (ea.RoutingKey == "user.activated")
                    {
                        var evt = JsonSerializer.Deserialize<UserActivatedEvent>(message);
                        if (evt != null)
                        {
                            var user = await db.Users.FirstOrDefaultAsync(u => u.Id == evt.UserId);
                            if (user != null)
                            {
                                user.IsActive = true;
                                await db.SaveChangesAsync();
                                _logger.LogInformation("[AuthService] User activated: {userId}", user.Id);
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Error processing message");
                }
                _channel.BasicAck(ea.DeliveryTag, false);
            };
            _channel.BasicConsume(queue: "user.created", autoAck: false, consumer: consumer);
            _channel.BasicConsume(queue: "user.rolechanged", autoAck: false, consumer: consumer);
            _channel.BasicConsume(queue: "user.deactivated", autoAck: false, consumer: consumer);
            _channel.BasicConsume(queue: "user.activated", autoAck: false, consumer: consumer);
            return Task.CompletedTask;
        }

        public override void Dispose()
        {
            _channel?.Dispose();
            _connection?.Dispose();
            base.Dispose();
        }
    }
}
