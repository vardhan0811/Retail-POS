using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using RabbitMQ.Client;
using RabbitMQ.Client.Events;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.DependencyInjection;

namespace NotificationService.Services
{
    public class RabbitMqConsumerHostedService : RabbitMqConsumerBase
    {
        private readonly IServiceScopeFactory _scopeFactory;
        private readonly IConfiguration _config;
        public RabbitMqConsumerHostedService(IConfiguration config, ILogger<RabbitMqConsumerHostedService> logger, IServiceScopeFactory scopeFactory)
            : base(config, logger, queueName: "notification.events", routingKeys: "user.created", "bill.created", "stock.failed", "stock.reserved")
        {
            _scopeFactory = scopeFactory;
            _config = config;
        }

        protected override async Task ProcessMessageAsync(byte[] body, string routingKey)
        {
            var message = Encoding.UTF8.GetString(body);
            // Example: Deserialize and log CorrelationId for all events
            if (routingKey == "user.created")
            {
                var evt = System.Text.Json.JsonSerializer.Deserialize<Shared.Contracts.Events.UserCreatedEvent>(message);
                if (evt != null)
                {
                    var logger = _scopeFactory.CreateScope().ServiceProvider.GetRequiredService<ILogger<RabbitMqConsumerHostedService>>();
                    logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
            }
            else if (routingKey == "bill.created")
            {
                var evt = System.Text.Json.JsonSerializer.Deserialize<Shared.Contracts.Events.BillCreatedEvent>(message);
                if (evt != null)
                {
                    var logger = _scopeFactory.CreateScope().ServiceProvider.GetRequiredService<ILogger<RabbitMqConsumerHostedService>>();
                    logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
            }
            else if (routingKey == "stock.failed")
            {
                var evt = System.Text.Json.JsonSerializer.Deserialize<Shared.Contracts.StockFailedEvent>(message);
                if (evt != null)
                {
                    var logger = _scopeFactory.CreateScope().ServiceProvider.GetRequiredService<ILogger<RabbitMqConsumerHostedService>>();
                    logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
            }
            else if (routingKey == "stock.reserved")
            {
                var evt = System.Text.Json.JsonSerializer.Deserialize<Shared.Contracts.StockReservedEvent>(message);
                if (evt != null)
                {
                    var logger = _scopeFactory.CreateScope().ServiceProvider.GetRequiredService<ILogger<RabbitMqConsumerHostedService>>();
                    logger.LogInformation("Processing event {CorrelationId}", evt.CorrelationId);
                }
            }
            // Here you would call OtpService or email/SMS logic as needed
        }
    }
}
