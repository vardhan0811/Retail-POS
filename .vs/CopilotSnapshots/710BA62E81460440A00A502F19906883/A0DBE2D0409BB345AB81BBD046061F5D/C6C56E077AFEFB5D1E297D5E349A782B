using ProductService.Data;
using ProductService.Entities;
using ProductService.Events;
using RabbitMQ.Client;
using RabbitMQ.Client.Events;
using System.Text;
using System.Text.Json;
namespace ProductService.Services
{
    public class RabbitMqConsumer
    {
        private readonly IServiceScopeFactory _scopeFactory;

        public RabbitMqConsumer(IServiceScopeFactory scopeFactory)
        {
            _scopeFactory = scopeFactory;
        }

        public void Start()
        {
            var factory = new ConnectionFactory() { HostName = "localhost" };

            var connection = factory.CreateConnection();
            var channel = connection.CreateModel();


            channel.QueueDeclare("bill-created", true, false, false, null);
            channel.QueueDeclare("store.deactivated", true, false, false, null);

            var consumer = new EventingBasicConsumer(channel);

            consumer.Received += async (model, ea) =>
            {
                var body = ea.Body.ToArray();
                var json = Encoding.UTF8.GetString(body);

                using var scope = _scopeFactory.CreateScope();
                var db = scope.ServiceProvider.GetRequiredService<ProductDbContext>();
                var service = scope.ServiceProvider.GetRequiredService<IProductService>();
                var publisher = scope.ServiceProvider.GetRequiredService<RabbitMqPublisher>();

                if (ea.RoutingKey == "bill-created")
                {
                    Console.WriteLine("💸 Bill Event Received");
                    Console.WriteLine(json);
                    var billEvent = JsonSerializer.Deserialize<BillCreatedEvent>(json);
                    try
                    {
                        // ✅ IDEMPOTENCY
                        var exists = db.ProcessedMessages
                            .Any(x => x.MessageId == billEvent.BillId);
                        if (exists)
                        {
                            Console.WriteLine("⚠️ Duplicate skipped");
                            channel.BasicAck(ea.DeliveryTag, false);
                            return;
                        }
                        // ✅ PROCESS STOCK
                        foreach (var item in billEvent.Items)
                        {
                            await service.ReduceStockAsync(item.ProductId, item.Quantity);
                        }
                        // ✅ SAVE PROCESSED
                        db.ProcessedMessages.Add(new ProcessedMessage
                        {
                            Id = Guid.NewGuid(),
                            MessageId = billEvent.BillId,
                            ProcessedAt = DateTime.UtcNow
                        });
                        db.SaveChanges();
                        // ✅ SUCCESS EVENT
                        publisher.Publish("stock-reserved", new
                        {
                            BillId = billEvent.BillId
                        });
                        channel.BasicAck(ea.DeliveryTag, false);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine("❌ STOCK FAILED");
                        // ✅ FAILURE EVENT
                        publisher.Publish("stock-failed", new
                        {
                            BillId = billEvent.BillId,
                            Reason = ex.Message
                        });
                        channel.BasicNack(ea.DeliveryTag, false, false);
                    }
                }
                else if (ea.RoutingKey == "store.deactivated")
                {
                    Console.WriteLine("🏪 Store Deactivated Event Received");
                    Console.WriteLine(json);
                    var storeEvent = JsonSerializer.Deserialize<Events.StoreDeactivatedEvent>(json);
                    var products = db.Products.Where(p => p.StoreId == storeEvent.StoreId && p.IsActive).ToList();
                    foreach (var product in products)
                    {
                        product.IsActive = false;
                    }
                    db.SaveChanges();
                    channel.BasicAck(ea.DeliveryTag, false);
                }
            };

            channel.BasicConsume(queue: "bill-created", autoAck: false, consumer: consumer);
            channel.BasicConsume(queue: "store.deactivated", autoAck: false, consumer: consumer);
        }
    }
}