using AuthService.DTOs;
using AuthService.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Security.Claims;


namespace AuthService.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    public class AuthController : ControllerBase
    {
        private readonly IAuthService _authService;

        public AuthController(IAuthService authService)
        {
            _authService = authService;
        }

        [HttpPost("register")]
        public async Task<IActionResult> Register(RegisterRequest request)
        {
            await _authService.RegisterAsync(request);
            return Ok("User registered");
        }

        [HttpPost("login")]
        public async Task<IActionResult> Login(LoginRequest request)
        {
            var response = await _authService.LoginAsync(request);
            return Ok(response);
        }

        [Authorize]
        [HttpGet("me")]
        public IActionResult GetMe()
        {
            return Ok(User.FindFirst(ClaimTypes.Email)?.Value);
        }

        [Authorize(Roles = "Admin")]
        [HttpPost("change-role")]
        public async Task<IActionResult> ChangeUserRole([FromBody] UserRoleChangeRequest request)
        {
            await _authService.ChangeUserRoleAsync(request);
            return Ok("User role changed");
        }

        [Authorize(Roles = "Admin")]
        [HttpPost("deactivate")]
        public async Task<IActionResult> DeactivateUser([FromBody] UserDeactivateRequest request)
        {
            await _authService.DeactivateUserAsync(request);
            return Ok("User deactivated");
        }

        [HttpPost("verify-otp")]
        public async Task<IActionResult> VerifyOtp([FromQuery] string email, [FromQuery] string otp)
        {
            // This should call NotificationClient.VerifyOtpAsync via AuthService (add method to IAuthService/AuthServices if needed)
            // For now, call directly if exposed, or add a method to IAuthService
            if (_authService is AuthServices concreteAuthService)
            {
                var result = await concreteAuthService.VerifyOtpAsync(email, otp);
                return result ? Ok("OTP verified.") : BadRequest("Invalid or expired OTP.");
            }
            return BadRequest("OTP verification not available.");
        }
    }
}
