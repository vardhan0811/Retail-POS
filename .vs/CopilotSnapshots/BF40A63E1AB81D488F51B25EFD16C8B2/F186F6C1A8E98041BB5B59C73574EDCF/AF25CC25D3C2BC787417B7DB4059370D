using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using ProductService.DTOs;
using ProductService.Entities;
using ProductService.Services;

namespace ProductService.Controllers
{
    [ApiController]
    [Route("api/products")]
    public class ProductController : ControllerBase
    {
        private readonly IProductService _service;

        public ProductController(IProductService service)
        {
            _service = service;
        }

        // 🔥 CREATE PRODUCT
        [Authorize(Policy = "CREATE_PRODUCT")]
        [HttpPost]
        public async Task<IActionResult> Create(CreateProductRequest request)
        {
            var product = await _service.CreateProductAsync(request);

            return Ok(new ApiResponse<Product>
            {
                Success = true,
                Message = "Product created successfully",
                Data = product
            });
        }

        // 🔍 SEARCH
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("search")]
        public async Task<IActionResult> Search(string query, Guid storeId)
        {
            var result = await _service.SearchAsync(query, storeId);

            return Ok(new ApiResponse<IEnumerable<Product>>
            {
                Success = true,
                Message = "Products fetched successfully",
                Data = result
            });
        }

        // 📦 GET BY ID
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("{id}")]
        public async Task<IActionResult> Get(Guid id)
        {
            var product = await _service.GetByIdAsync(id);

            return Ok(new ApiResponse<Product>
            {
                Success = true,
                Message = "Product fetched successfully",
                Data = product
            });
        }

        // ✏️ UPDATE
        [Authorize(Policy = "UPDATE_PRODUCT")]
        [HttpPut("{id}")]
        public async Task<IActionResult> Update(Guid id, UpdateProductRequest request)
        {
            await _service.UpdateAsync(id, request);

            var updatedProduct = await _service.GetByIdAsync(id);

            return Ok(new ApiResponse<Product>
            {
                Success = true,
                Message = "Product updated successfully",
                Data = updatedProduct
            });
        }

        // ❌ DELETE (SOFT DELETE)
        [Authorize(Policy = "DELETE_PRODUCT")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(Guid id)
        {
            await _service.DeleteAsync(id);

            return Ok(new ApiResponse<string>
            {
                Success = true,
                Message = "Product deleted successfully",
                Data = null
            });
        }

        // 📄 PAGINATION
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("paged")]
        public async Task<IActionResult> GetPaged(
        [FromQuery] Guid storeId,
        [FromQuery] int page = 1,
        [FromQuery] int pageSize = 5,
        [FromQuery] string? search = null,
        [FromQuery] decimal? minPrice = null,
        [FromQuery] decimal? maxPrice = null,
        [FromQuery] string? sortBy = null)
        {
            var result = await _service.GetPagedAsync(
                storeId, page, pageSize, search, minPrice, maxPrice, sortBy);

            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Products fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "UPDATE_PRODUCT")]
        [HttpPost("reduce-stock")]
        public async Task<IActionResult> ReduceStock(Guid productId, int quantity)
        {
            await _service.ReduceStockAsync(productId, quantity);
            return Ok(new ApiResponse<string>
            {
                Success = true,
                Message = "Stock updated successfully",
                Data = null
            });
        }
    }
}