using BillingService.DTOs;
using BillingService.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Security.Claims;
using System;
using System.Threading.Tasks;
using System.Collections.Generic;

namespace BillingService.Controllers
{
    [ApiController]
    [Route("api/bills")]
    public class BillingController : ControllerBase
    {
        private readonly IBillingService _service;

        public BillingController(IBillingService service)
        {
            _service = service;
        }

        [Authorize(Policy = "CREATE_BILL")]
        [HttpPost]
        public async Task<IActionResult> Create(CreateBillRequest request)
        {
            var userId = Guid.Parse(User.FindFirst(ClaimTypes.NameIdentifier).Value);
            var storeId = Guid.Parse(User.FindFirst("storeId").Value);
            var result = await _service.CreateBillAsync(request, userId, storeId);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Bill created successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet]
        public async Task<IActionResult> GetAll()
        {
            var result = await _service.GetAllAsync();
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bills fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("{id}")]
        public async Task<IActionResult> GetById(Guid id)
        {
            var result = await _service.GetByIdAsync(id);
            if (result == null)
                return NotFound(new ApiResponse<object> { Success = false, Message = "Bill not found", Data = null });
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Bill fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("status/{status}")]
        public async Task<IActionResult> GetByStatus(string status)
        {
            var result = await _service.GetByStatusAsync(status);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = $"Bills with status '{status}' fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("user/{userId}")]
        public async Task<IActionResult> GetByUser(Guid userId)
        {
            var result = await _service.GetByUserAsync(userId);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bills for user fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("today")]
        public async Task<IActionResult> GetToday()
        {
            var result = await _service.GetTodayAsync();
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Today's bills fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("date-range")]
        public async Task<IActionResult> GetByDateRange([FromQuery] DateTime start, [FromQuery] DateTime end)
        {
            var result = await _service.GetByDateRangeAsync(start, end);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bills in date range fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("total-revenue")]
        public async Task<IActionResult> GetTotalRevenue()
        {
            var result = await _service.GetTotalRevenueAsync();
            return Ok(new ApiResponse<decimal>
            {
                Success = true,
                Message = "Total revenue fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "CANCEL_BILL")]
        [HttpPost("{id}/cancel")]
        public async Task<IActionResult> Cancel(Guid id)
        {
            await _service.CancelAsync(id);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Bill cancelled successfully",
                Data = null
            });
        }

        [Authorize(Policy = "RETRY_BILL")]
        [HttpPost("{id}/retry")]
        public async Task<IActionResult> Retry(Guid id)
        {
            await _service.RetryAsync(id);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Bill retry triggered successfully",
                Data = null
            });
        }

        // Advanced endpoints
        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("store/{storeId}")]
        public async Task<IActionResult> GetByStore(Guid storeId)
        {
            var result = await _service.GetByStoreAsync(storeId);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bills for store fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("user/{userId}/date-range")]
        public async Task<IActionResult> GetByUserDateRange(Guid userId, [FromQuery] DateTime start, [FromQuery] DateTime end)
        {
            var result = await _service.GetByUserDateRangeAsync(userId, start, end);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bills for user in date range fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("store/{storeId}/date-range")]
        public async Task<IActionResult> GetByStoreDateRange(Guid storeId, [FromQuery] DateTime start, [FromQuery] DateTime end)
        {
            var result = await _service.GetByStoreDateRangeAsync(storeId, start, end);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bills for store in date range fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("search")]
        public async Task<IActionResult> Search([FromQuery] string q)
        {
            var result = await _service.SearchAsync(q);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bills search completed",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("store/{storeId}/revenue")]
        public async Task<IActionResult> GetStoreRevenue(Guid storeId)
        {
            var result = await _service.GetStoreRevenueAsync(storeId);
            return Ok(new ApiResponse<decimal>
            {
                Success = true,
                Message = "Store revenue fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("store/{storeId}/top-customers")]
        public async Task<IActionResult> GetTopCustomers(Guid storeId, [FromQuery] int count = 10)
        {
            var result = await _service.GetTopCustomersAsync(storeId, count);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Top customers fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("store/{storeId}/top-products")]
        public async Task<IActionResult> GetTopProducts(Guid storeId, [FromQuery] int count = 10)
        {
            var result = await _service.GetTopProductsAsync(storeId, count);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Top products fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "REFUND_BILL")]
        [HttpPost("{id}/refund")]
        public async Task<IActionResult> Refund(Guid id)
        {
            await _service.RefundAsync(id);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Bill refunded successfully",
                Data = null
            });
        }

        [Authorize(Policy = "MARK_PAID_BILL")]
        [HttpPost("{id}/mark-paid")]
        public async Task<IActionResult> MarkPaid(Guid id)
        {
            await _service.MarkPaidAsync(id);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Bill marked as paid successfully",
                Data = null
            });
        }

        [Authorize(Policy = "ADD_NOTE_BILL")]
        [HttpPost("{id}/add-note")]
        public async Task<IActionResult> AddNote(Guid id, [FromBody] string note)
        {
            await _service.AddNoteAsync(id, note);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Note added to bill successfully",
                Data = null
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("{id}/history")]
        public async Task<IActionResult> GetHistory(Guid id)
        {
            var result = await _service.GetHistoryAsync(id);
            return Ok(new ApiResponse<IEnumerable<object>>
            {
                Success = true,
                Message = "Bill history fetched successfully",
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_BILL")]
        [HttpGet("paged")]
        public async Task<IActionResult> GetPaged([FromQuery] int page = 1, [FromQuery] int pageSize = 20, [FromQuery] string? status = null, [FromQuery] Guid? userId = null, [FromQuery] Guid? storeId = null, [FromQuery] DateTime? start = null, [FromQuery] DateTime? end = null, [FromQuery] string? sortBy = null)
        {
            var (bills, total) = await _service.GetPagedAsync(page, pageSize, status, userId, storeId, start, end, sortBy);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Paged bills fetched successfully",
                Data = new { bills, total }
            });
        }

        [Authorize(Policy = "EXPORT_BILL")]
        [HttpGet("export/csv")]
        public async Task<IActionResult> ExportCsv()
        {
            var csv = await _service.ExportCsvAsync();
            return File(System.Text.Encoding.UTF8.GetBytes(csv), "text/csv", "bills.csv");
        }
    }
}