using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using ProductService.Entities;
using ProductService.Data;
using System;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;

namespace ProductService.Controllers
{
    [ApiController]
    [Route("api/products/categories")]
    [Authorize]
    public class CategoryController : ControllerBase
    {
        private readonly ProductDbContext _db;
        public CategoryController(ProductDbContext db)
        {
            _db = db;
        }

        [HttpGet]
        public async Task<IActionResult> GetAll([FromQuery] Guid storeId)
        {
            var categories = await _db.Categories.Where(c => c.StoreId == storeId).ToListAsync();
            return Ok(categories);
        }

        [HttpGet("{id}")]
        public async Task<IActionResult> GetById(Guid id)
        {
            var category = await _db.Categories.FindAsync(id);
            if (category == null) return NotFound();
            return Ok(category);
        }

        [Authorize(Policy = "MANAGE_CATEGORY")]
        [HttpPost]
        public async Task<IActionResult> Create([FromBody] Category category)
        {
            category.Id = Guid.NewGuid();
            _db.Categories.Add(category);
            await _db.SaveChangesAsync();
            return Ok(category);
        }

        [Authorize(Policy = "MANAGE_CATEGORY")]
        [HttpPut("{id}")]
        public async Task<IActionResult> Update(Guid id, [FromBody] Category update)
        {
            var category = await _db.Categories.FindAsync(id);
            if (category == null) return NotFound();
            category.Name = update.Name;
            await _db.SaveChangesAsync();
            return Ok(category);
        }

        [Authorize(Policy = "MANAGE_CATEGORY")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(Guid id)
        {
            var category = await _db.Categories.FindAsync(id);
            if (category == null) return NotFound();
            _db.Categories.Remove(category);
            await _db.SaveChangesAsync();
            return NoContent();
        }
    }
}
