using AdminService.Data;
using AdminService.Entities;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Shared.Contracts.Events;
using System.Text;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using Shared.Messaging.RabbitMq;

namespace AdminService.Services
{
    public sealed class DashboardEventsConsumerHostedService : RabbitMqConsumerBase
    {
        private readonly IServiceScopeFactory _scopeFactory;

        public DashboardEventsConsumerHostedService(
            IConfiguration config,
            ILogger<DashboardEventsConsumerHostedService> logger,
            IServiceScopeFactory scopeFactory)
            : base(config, logger, "admin.dashboard.events", "bill.created", "stock.reserved", "stock.failed")

        {
            _scopeFactory = scopeFactory;
        }

        protected override async Task ProcessMessageAsync(byte[] body, string routingKey, CancellationToken ct)
        {
            using var scope = _scopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AdminDbContext>();

            var summary = await db.DashboardSummaries.FirstOrDefaultAsync(x => x.Id == 1, ct)
                          ?? new DashboardSummary { Id = 1 };

            var json = Encoding.UTF8.GetString(body);
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            if (routingKey == "bill.created")
            {
                var _ = JsonSerializer.Deserialize<BillCreatedEvent>(json, opts)
                        ?? throw new System.InvalidOperationException("Failed to deserialize BillCreatedEvent.");

                summary.TotalBills += 1;
                summary.PendingBills += 1;
            }
            else if (routingKey == "stock.reserved")
            {
                var _ = JsonSerializer.Deserialize<StockReservedEvent>(json, opts)
                        ?? throw new System.InvalidOperationException("Failed to deserialize StockReservedEvent.");

                if (summary.PendingBills > 0) summary.PendingBills -= 1;
                summary.ConfirmedBills += 1;
            }
            else if (routingKey == "stock.failed")
            {
                var _ = JsonSerializer.Deserialize<StockFailedEvent>(json, opts)
                        ?? throw new System.InvalidOperationException("Failed to deserialize StockFailedEvent.");

                if (summary.PendingBills > 0) summary.PendingBills -= 1;
                summary.FailedBills += 1;
            }

            summary.LastUpdatedUtc = System.DateTime.UtcNow;

            db.DashboardSummaries.Update(summary);
            await db.SaveChangesAsync(ct);
        }
    }
}
