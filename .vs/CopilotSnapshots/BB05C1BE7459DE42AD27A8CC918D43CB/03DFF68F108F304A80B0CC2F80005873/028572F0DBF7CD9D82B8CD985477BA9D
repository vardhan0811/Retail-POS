using ProductService.DTOs;
using ProductService.Entities;

namespace ProductService.Services
{
    public interface IProductService
    {
        Task<Product> CreateProductAsync(CreateProductRequest request);
        Task<Product> GetByIdAsync(Guid id);
        Task<IEnumerable<Product>> SearchAsync(string query, Guid storeId);
        Task UpdateAsync(Guid id, UpdateProductRequest request);
        Task DeleteAsync(Guid id);
        Task<object> GetPagedAsync(Guid storeId, int page, int pageSize, string? search = null, decimal? minPrice = null, decimal? maxPrice = null, string? sortBy = null);
        Task ReduceStockAsync(Guid productId, int quantity);

        // Category endpoints
        Task<IEnumerable<ProductService.Entities.Category>> GetAllCategoriesAsync(Guid storeId);
        Task<ProductService.Entities.Category?> GetCategoryByIdAsync(Guid id);
        Task<ProductService.Entities.Category> CreateCategoryAsync(ProductService.Entities.Category category);
        Task<ProductService.Entities.Category?> UpdateCategoryAsync(Guid id, ProductService.Entities.Category update);
        Task<bool> DeleteCategoryAsync(Guid id);

        // Lookup endpoint
        Task<IEnumerable<Product>> LookupAsync(Guid storeId, string query);

        // Existing endpoints
        Task<IEnumerable<Product>> GetByCategoryAsync(Guid categoryId, Guid storeId);
        Task<IEnumerable<Product>> GetLowStockAsync(Guid storeId, int threshold);
        Task<IEnumerable<Product>> GetOutOfStockAsync(Guid storeId);
        Task IncreaseStockAsync(Guid productId, int quantity);
        Task DecreaseStockAsync(Guid productId, int quantity);
        Task BulkUpdateStockAsync(IEnumerable<(Guid productId, int quantity)> updates);
        Task<object> GetStockSummaryAsync(Guid storeId);
        Task<IEnumerable<Product>> GetTopSellingAsync(Guid storeId, int count);
    }
}