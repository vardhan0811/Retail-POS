using Microsoft.EntityFrameworkCore;
using ProductService.Data;
using ProductService.DTOs;
using ProductService.Entities;

namespace ProductService.Repositories
{
    public class ProductRepository : IProductRepository
    {
        private readonly ProductDbContext _context;

        private IQueryable<Product> BuildSearchQuery(Guid storeId, string query, bool includeTax)
        {
            var normalized = query.Trim();
            var q = _context.Products.AsNoTracking().Where(p => p.StoreId == storeId && p.IsActive);
            if (includeTax)
            {
                q = q.Include(p => p.Tax);
            }

            return q.Where(p =>
                p.Name.Contains(normalized) ||
                p.SKU.Contains(normalized) ||
                p.Barcode.Contains(normalized));
        }

        public ProductRepository(ProductDbContext context)
        {
            _context = context;
        }

        // ---------------- CREATE ----------------
        public async Task AddAsync(Product product)
        {
            await _context.Products.AddAsync(product);
            await _context.SaveChangesAsync();
        }

        // ---------------- UPDATE ----------------
        public async Task UpdateAsync(Product product)
        {
            _context.Products.Update(product);
            await _context.SaveChangesAsync();
        }

        // ---------------- DELETE (SOFT DELETE SUPPORT) ----------------
        public async Task DeleteAsync(Product product)
        {
            _context.Products.Update(product);
            await _context.SaveChangesAsync();
        }

        // ---------------- GET ----------------
        public async Task<Product?> GetByIdAsync(Guid id)
        {
            return await _context.Products
                .AsNoTracking()
                .Include(p => p.Tax)
                .FirstOrDefaultAsync(p => p.Id == id && p.IsActive);
        }

        // ---------------- EXISTS ----------------
        public async Task<bool> ExistsBySKUAsync(string sku, Guid storeId, Guid? excludeId = null)
        {
            return await _context.Products.AnyAsync(p =>
                p.StoreId == storeId &&
                p.SKU == sku &&
                p.IsActive &&
                (!excludeId.HasValue || p.Id != excludeId)
            );
        }

        public async Task<bool> ExistsByBarcodeAsync(string barcode, Guid storeId, Guid? excludeId = null)
        {
            return await _context.Products.AnyAsync(p =>
                p.StoreId == storeId &&
                p.Barcode == barcode &&
                p.IsActive &&
                (!excludeId.HasValue || p.Id != excludeId)
            );
        }

        // ---------------- SEARCH (FIXED: PURE DB) ----------------
        public async Task<IEnumerable<Product>> SearchAsync(string query, Guid storeId)
        {
            if (string.IsNullOrWhiteSpace(query))
                return Enumerable.Empty<Product>();

            return await BuildSearchQuery(storeId, query, includeTax: true).ToListAsync();
        }

        // ---------------- PAGINATION ----------------
        public async Task<(IEnumerable<Product>, int)> GetPagedAsync(
            Guid storeId,
            int page,
            int pageSize,
            string? search,
            decimal? minPrice,
            decimal? maxPrice,
            string? sortBy)
        {
            page = page < 1 ? 1 : page;
            pageSize = pageSize < 1 ? 20 : pageSize;

            var query = _context.Products
                .Include(p => p.Tax)
                .Where(p => p.StoreId == storeId && p.IsActive)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(search))
            {
                search = search.Trim();
                query = query.Where(p =>
                    p.Name.Contains(search) ||
                    p.SKU.Contains(search) ||
                    p.Barcode.Contains(search));
            }

            if (minPrice.HasValue)
                query = query.Where(p => p.SellingPrice >= minPrice.Value);

            if (maxPrice.HasValue)
                query = query.Where(p => p.SellingPrice <= maxPrice.Value);

            query = sortBy switch
            {
                "price_asc" => query.OrderBy(p => p.SellingPrice),
                "price_desc" => query.OrderByDescending(p => p.SellingPrice),
                "name_desc" => query.OrderByDescending(p => p.Name),
                _ => query.OrderBy(p => p.Name)
            };

            var total = await query.CountAsync();

            var items = await query
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();

            return (items, total);
        }

        // ---------------- FILTERS ----------------
        public async Task<IEnumerable<Product>> GetByCategoryAsync(Guid categoryId, Guid storeId)
        {
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.CategoryId == categoryId && p.StoreId == storeId && p.IsActive)
                .ToListAsync();
        }

        public async Task<IEnumerable<Product>> GetLowStockAsync(Guid storeId, int threshold)
        {
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.StoreId == storeId && p.IsActive && p.Stock > 0 && p.Stock <= threshold)
                .ToListAsync();
        }

        public async Task<IEnumerable<Product>> GetOutOfStockAsync(Guid storeId)
        {
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.StoreId == storeId && p.IsActive && p.Stock == 0)
                .ToListAsync();
        }

        // ---------------- STOCK ----------------
        public async Task BulkUpdateStockAsync(IEnumerable<ProductService.DTOs.StockUpdateItem> updates)
        {
            var ids = updates.Select(u => u.ProductId).ToList();

            var products = await _context.Products
                .Where(p => ids.Contains(p.Id) && p.IsActive)
                .ToListAsync();

            foreach (var update in updates)
            {
                var product = products.FirstOrDefault(p => p.Id == update.ProductId);
                if (product == null)
                    throw new InvalidOperationException($"Product {update.ProductId} not found or inactive.");

                if (update.Quantity < 0)
                    throw new InvalidOperationException("Stock cannot go negative");

                product.Stock = update.Quantity;
            }

            await _context.SaveChangesAsync();
        }

        public async Task<StockSummaryDto> GetStockSummaryAsync(Guid storeId)
        {
            var total = await _context.Products.CountAsync(p => p.StoreId == storeId && p.IsActive);
            var low = await _context.Products.CountAsync(p => p.StoreId == storeId && p.IsActive && p.Stock > 0 && p.Stock <= 5);
            var outOfStock = await _context.Products.CountAsync(p => p.StoreId == storeId && p.IsActive && p.Stock == 0);

            return new StockSummaryDto
            {
                Total = total,
                Low = low,
                OutOfStock = outOfStock
            };
        }

        public async Task<bool> HasActiveProductsInCategoryAsync(Guid categoryId)
        {
            return await _context.Products.AnyAsync(p => p.CategoryId == categoryId && p.IsActive);
        }

        // ---------------- CATEGORY ----------------
        public async Task<IEnumerable<Category>> GetAllCategoriesAsync(Guid storeId)
        {
            return await _context.Categories
                .AsNoTracking()
                .Where(c => c.StoreId == storeId && c.IsActive)
                .ToListAsync();
        }

        public async Task<Category?> GetCategoryByIdAsync(Guid id)
        {
            return await _context.Categories
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.Id == id && c.IsActive);
        }

        public async Task<Category> CreateCategoryAsync(Category category)
        {
            category.Id = Guid.NewGuid();
            category.IsActive = true;

            _context.Categories.Add(category);
            await _context.SaveChangesAsync();

            return category;
        }

        public async Task<Category?> UpdateCategoryAsync(Guid id, Category update)
        {
            var category = await _context.Categories.FirstOrDefaultAsync(c => c.Id == id && c.IsActive);
            if (category == null) return null;

            category.Name = update.Name;
            await _context.SaveChangesAsync();

            return category;
        }

        public async Task<bool> DeleteCategoryAsync(Guid id)
        {
            var category = await _context.Categories.FirstOrDefaultAsync(c => c.Id == id && c.IsActive);
            if (category == null) return false;

            category.IsActive = false;
            await _context.SaveChangesAsync();

            return true;
        }

        // ---------------- LOOKUP ----------------
        public async Task<IEnumerable<Product>> LookupAsync(Guid storeId, string query)
        {
            if (string.IsNullOrWhiteSpace(query))
                return Enumerable.Empty<Product>();

            return await BuildSearchQuery(storeId, query, includeTax: false)
                .OrderBy(p => p.Name)
                .Take(20)
                .ToListAsync();
        }

        // ---------------- ANALYTICS ----------------
        public async Task<IEnumerable<Product>> GetTopSellingAsync(Guid storeId, int count)
        {
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.StoreId == storeId && p.IsActive)
                .OrderBy(p => p.Stock) // placeholder logic
                .Take(count)
                .ToListAsync();
        }
    }
}