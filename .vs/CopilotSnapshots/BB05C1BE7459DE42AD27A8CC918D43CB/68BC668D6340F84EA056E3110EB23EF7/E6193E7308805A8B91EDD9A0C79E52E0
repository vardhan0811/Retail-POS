using Microsoft.Extensions.Caching.Memory;
using Microsoft.Extensions.Options;
using System.Security.Cryptography;
using System.Net.Mail;
using System.Net;

namespace NotificationService.Services
{
    public class EmailSettings
    {
        public string FromEmail { get; set; } = string.Empty;
        public string AppPassword { get; set; } = string.Empty;
    }

    public class OtpService
    {
        private readonly IMemoryCache _cache;
        private readonly EmailSettings _emailSettings;
        public OtpService(IMemoryCache cache, IOptions<EmailSettings> emailOptions)
        {
            _cache = cache;
            _emailSettings = emailOptions.Value;
        }

        public string GenerateOtp(string email)
        {
            var otp = RandomNumberGenerator.GetInt32(100000, 999999).ToString();
            _cache.Set(email, otp, TimeSpan.FromMinutes(5));
            return otp;
        }

        public bool VerifyOtp(string email, string otp)
        {
            if (_cache.TryGetValue(email, out string? cachedOtp) && cachedOtp == otp)
            {
                _cache.Remove(email);
                return true;
            }
            return false;
        }

        public void SendOtpEmail(string email, string otp)
        {
            var smtpClient = new SmtpClient("smtp.gmail.com")
            {
                Port = 587,
                Credentials = new NetworkCredential(_emailSettings.FromEmail, _emailSettings.AppPassword),
                EnableSsl = true,
            };
            var mail = new MailMessage(_emailSettings.FromEmail, email)
            {
                Subject = "Your OTP Code",
                Body = $"Your OTP code is: {otp}",
            };
            smtpClient.Send(mail);
        }
    }
}
