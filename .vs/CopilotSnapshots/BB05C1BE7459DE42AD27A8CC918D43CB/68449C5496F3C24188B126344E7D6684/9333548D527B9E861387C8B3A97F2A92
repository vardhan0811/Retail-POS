using AuthService.DTOs;
using AuthService.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Security.Claims;
using AuthService.Data;
using Microsoft.EntityFrameworkCore;
using AuthService.Entities;
using Microsoft.Extensions.Logging;
using Shared.Contracts.Events;
using Shared.Messaging.RabbitMq;

namespace AuthService.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    public class AuthController : ControllerBase
    {
        private readonly IAuthService _authService;
        private readonly AuthDbContext _db;
        private readonly RefreshTokenService _refreshTokenService;
        private readonly ILogger<AuthController> _logger;
        private readonly RabbitMqPublisherBase _rabbitMqPublisher;

        public AuthController(IAuthService authService, AuthDbContext db, RefreshTokenService refreshTokenService, ILogger<AuthController> logger, RabbitMqPublisherBase rabbitMqPublisher)
        {
            _authService = authService;
            _db = db;
            _refreshTokenService = refreshTokenService;
            _logger = logger;
            _rabbitMqPublisher = rabbitMqPublisher;
        }

        [Authorize]
        [HttpGet("me")]
        public IActionResult GetMe()
        {
            var email = User.FindFirst(ClaimTypes.Email)?.Value;
            var role = User.FindFirst(ClaimTypes.Role)?.Value;
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "User info fetched successfully",
                Data = new { Email = email, Role = role }
            });
        }

        [HttpGet("stores")]
        [AllowAnonymous]
        public async Task<IActionResult> GetAllStores()
        {
            var stores = await _authService.GetAllStoresAsync();
            return Ok(new ApiResponse<List<Store>>
            {
                Success = true,
                Message = "Stores fetched successfully",
                Data = stores
            });
        }

        [AllowAnonymous]
        [HttpGet("store/{id}")]
        public async Task<IActionResult> GetStoreById(Guid id)
        {
            var store = await _db.Stores.FindAsync(id);
            if (store == null)
            {
                return NotFound(new ApiResponse<Store>
                {
                    Success = false,
                    Message = "Store not found",
                    Data = null
                });
            }

            return Ok(new ApiResponse<Store>
            {
                Success = true,
                Message = "Store fetched successfully",
                Data = store
            });
        }

        [HttpPost("register")]
        [AllowAnonymous]
        public async Task<IActionResult> Register(RegisterRequest request)
        {
            await _authService.RegisterAsync(request);
            return Ok(new ApiResponse<string>
            {
                Success = true,
                Message = "OTP Sent Successfully",
                Data = null
            });
        }

        [HttpPost("login")]
        [AllowAnonymous]
        public async Task<IActionResult> Login(LoginRequest request)
        {
            var response = await _authService.LoginAsync(request);

            var user = await _db.Users.FirstOrDefaultAsync(u => u.Email == request.Email);
            if (user == null)
                return Unauthorized(new ApiResponse<string> { Success = false, Message = "Invalid credentials", Data = null });

            var refreshToken = _refreshTokenService.GenerateRefreshToken(user.Id);
            Response.Cookies.Append("refreshToken", refreshToken, new CookieOptions
            {
                HttpOnly = true,
                Secure = true,
                SameSite = SameSiteMode.Strict,
                Expires = DateTimeOffset.UtcNow.AddDays(7)
            });

            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Login successful",
                Data = response
            });
        }

        [HttpPost("refresh")]
        [AllowAnonymous]
        public async Task<IActionResult> Refresh()
        {
            if (!Request.Cookies.TryGetValue("refreshToken", out var refreshToken))
                return Unauthorized(new ApiResponse<string> { Success = false, Message = "No refresh token", Data = null });

            var users = await _db.Users
                .Include(u => u.Role)
                .ThenInclude(r => r.RolePermissions)
                .ThenInclude(rp => rp.Permission)
                .ToListAsync();

            var user = users.FirstOrDefault(u => _refreshTokenService.ValidateRefreshToken(u.Id, refreshToken));
            if (user == null)
                return Unauthorized(new ApiResponse<string> { Success = false, Message = "Invalid refresh token", Data = null });

            var permissions = user.Role?.RolePermissions?
                .Select(rp => rp.Permission?.Name)
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Select(p => p!)
                .ToList() ?? new List<string>();

            var jwtService = HttpContext.RequestServices.GetRequiredService<IJwtService>();
            var newJwt = jwtService.GenerateToken(user, permissions);

            var newRefreshToken = _refreshTokenService.GenerateRefreshToken(user.Id);
            Response.Cookies.Append("refreshToken", newRefreshToken, new CookieOptions
            {
                HttpOnly = true,
                Secure = true,
                SameSite = SameSiteMode.Strict,
                Expires = DateTimeOffset.UtcNow.AddDays(7)
            });

            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Token refreshed",
                Data = new { Token = newJwt, Email = user.Email }
            });
        }

        [Authorize(Roles = "Admin")]
        [HttpPost("change-role")]
        public async Task<IActionResult> ChangeUserRole([FromBody] UserRoleChangeRequest request)
        {
            await _authService.ChangeUserRoleAsync(request);
            return Ok(new ApiResponse<string>
            {
                Success = true,
                Message = "User role changed",
                Data = null
            });
        }

        [Authorize(Roles = "Admin")]
        [HttpPost("deactivate")]
        public async Task<IActionResult> DeactivateUser([FromBody] UserDeactivateRequest request)
        {
            await _authService.DeactivateUserAsync(request);
            return Ok(new ApiResponse<string>
            {
                Success = true,
                Message = "User deactivated",
                Data = null
            });
        }

        [Authorize(Roles = "Admin")]
        [HttpPost("activate")]
        public async Task<IActionResult> ActivateUser([FromBody] UserDeactivateRequest request)
        {
            await _authService.ActivateUserAsync(request);
            return Ok(new ApiResponse<string>
            {
                Success = true,
                Message = "User activated",
                Data = null
            });
        }

        [HttpPost("verify-otp")]
        [AllowAnonymous]
        public async Task<IActionResult> VerifyOtp([FromQuery] string email, [FromQuery] string otp)
        {
            var result = await _authService.VerifyOtpAsync(email, otp);
            if (result)
            {
                return Ok(new ApiResponse<string>
                {
                    Success = true,
                    Message = "OTP verified successfully, Account Created.",
                    Data = null
                });
            }

            return BadRequest(new ApiResponse<string>
            {
                Success = false,
                Message = "Invalid or expired OTP.",
                Data = null
            });
        }

        [Authorize(Roles = "Admin")]
        [HttpPost("stores")]
        public async Task<IActionResult> CreateStore([FromBody] Store request)
        {
            if (string.IsNullOrWhiteSpace(request.Name))
                return BadRequest(new ApiResponse<string> { Success = false, Message = "Name is required", Data = null });

            if (string.IsNullOrWhiteSpace(request.Location))
                return BadRequest(new ApiResponse<string> { Success = false, Message = "Location is required", Data = null });

            var store = new Store
            {
                Id = Guid.NewGuid(),
                Name = request.Name.Trim(),
                Location = request.Location.Trim(),
                IsActive = true
            };

            _db.Stores.Add(store);
            await _db.SaveChangesAsync();

            var evt = new StoreCreatedEvent
            {
                MessageId = Guid.NewGuid(),
                CorrelationId = Guid.NewGuid(),
                StoreId = store.Id,
                Name = store.Name,
                Location = store.Location,
                IsActive = store.IsActive
            };

            _rabbitMqPublisher.Publish(evt, "store.created");

            return Ok(new ApiResponse<Store>
            {
                Success = true,
                Message = "Store created successfully",
                Data = store
            });
        }

    }
}
