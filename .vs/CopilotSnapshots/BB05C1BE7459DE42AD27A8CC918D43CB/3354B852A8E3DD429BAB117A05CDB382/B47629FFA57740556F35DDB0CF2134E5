using Microsoft.Extensions.Caching.Memory;
using System;

namespace AuthService.Services
{
    public class RefreshTokenService
    {
        private readonly IMemoryCache _cache;
        private readonly TimeSpan _refreshTokenLifetime = TimeSpan.FromDays(7);

        public RefreshTokenService(IMemoryCache cache)
        {
            _cache = cache;
        }

        public string GenerateRefreshToken(Guid userId)
        {
            var token = Convert.ToBase64String(Guid.NewGuid().ToByteArray()) + Convert.ToBase64String(Guid.NewGuid().ToByteArray());
            _cache.Set(userId, token, _refreshTokenLifetime);
            return token;
        }

        public bool ValidateRefreshToken(Guid userId, string token)
        {
            if (_cache.TryGetValue(userId, out string? cachedToken) && cachedToken == token)
                return true;
            return false;
        }

        public void RemoveRefreshToken(Guid userId)
        {
            _cache.Remove(userId);
        }
    }
}
