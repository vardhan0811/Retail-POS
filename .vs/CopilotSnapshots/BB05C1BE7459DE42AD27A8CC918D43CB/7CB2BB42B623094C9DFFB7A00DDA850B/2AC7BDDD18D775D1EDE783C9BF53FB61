            }
        }

        [Authorize(Policy = "VIEW_REPORTS")]
        [HttpGet("top-products")]
        public async Task<IActionResult> GetTopProducts([FromQuery] Guid storeId, [FromQuery] int count = 10)
        {
            var billingServiceBaseUrl = _config["ServiceUrls:BillingService"];
            if (string.IsNullOrWhiteSpace(billingServiceBaseUrl))
            {
                _logger.LogError("ServiceUrls:BillingService is missing");
                return StatusCode(500, new ApiResponse<object> { Success = false, Message = "BillingService URL is not configured", Data = null });
            }

            var client = CreateClientWithAuth();
            try
            {
                var response = await client.GetAsync($"{billingServiceBaseUrl.TrimEnd('/')}/api/bills/reports/top-products?storeId={storeId}&count={count}");
                if (!response.IsSuccessStatusCode)
                {
                    var errorBody = await response.Content.ReadAsStringAsync();
                    _logger.LogError("BillingService returned {StatusCode}. Body: {Body}", (int)response.StatusCode, errorBody);
                    return StatusCode((int)response.StatusCode, new ApiResponse<object> { Success = false, Message = "Failed to fetch top products report", Data = null });
                }

                var payload = await response.Content.ReadFromJsonAsync<ApiResponse<IReadOnlyList<TopProductViewDto>>>();
                return Ok(new ApiResponse<IReadOnlyList<TopProductViewDto>>
                {
                    Success = true,
                    Message = "Top products fetched successfully",
                    Data = payload?.Data ?? Array.Empty<TopProductViewDto>()
                });
            }
            catch (HttpRequestException ex)
            {
                _logger.LogError(ex, "BillingService call failed");
                return StatusCode(503, new ApiResponse<object> { Success = false, Message = "BillingService unavailable", Data = null });
            }
            catch (TaskCanceledException ex)
            {
                _logger.LogError(ex, "BillingService call timed out");
                return StatusCode(503, new ApiResponse<object> { Success = false, Message = "BillingService timeout", Data = null });
            }
        }
    }
}
