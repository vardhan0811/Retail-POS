using Microsoft.EntityFrameworkCore;
using ProductService.Data;
using ProductService.Entities;

namespace ProductService.Repositories
{
    public class ProductRepository : IProductRepository
    {
        private readonly ProductDbContext _context;

        public ProductRepository(ProductDbContext context)
        {
            _context = context;
        }

        // ✅ CREATE
        public async Task AddAsync(Product product)
        {
            await _context.Products.AddAsync(product);
            await _context.SaveChangesAsync();
        }

        // ✅ UPDATE (used for both update + soft delete)
        public async Task UpdateAsync(Product product)
        {
            _context.Products.Update(product);
            await _context.SaveChangesAsync();
        }

        // ✅ GET BY ID (FILTER ACTIVE)
        public async Task<Product?> GetByIdAsync(Guid id)
        {
            return await _context.Products
                .AsNoTracking() // 🔥 read-only optimization
                .Include(p => p.Tax)
                .FirstOrDefaultAsync(p => p.Id == id && p.IsActive);
        }

        // ✅ SEARCH (HYBRID: DB filter + in-memory search)
        public async Task<IEnumerable<Product>> SearchAsync(string query, Guid storeId)
        {
            if (string.IsNullOrWhiteSpace(query))
                return Enumerable.Empty<Product>();

            // Step 1: DB filtering (reduce dataset early)
            var products = await _context.Products
                .AsNoTracking() // 🔥 performance
                .Include(p => p.Tax)
                .Where(p => p.StoreId == storeId && p.IsActive)
                .ToListAsync();

            // Step 2: Normalize query
            query = query.Trim().ToLower();

            // Step 3: In-memory search (safe & flexible)
            Guid parsedId;
            var isGuid = Guid.TryParse(query, out parsedId);

            return products.Where(p =>
                (isGuid && p.Id == parsedId) // 🔥 NEW (ID SEARCH)
                || (!string.IsNullOrEmpty(p.Name) && p.Name.ToLower().Contains(query))
                || (!string.IsNullOrEmpty(p.Barcode) && p.Barcode.Contains(query))
                || (!string.IsNullOrEmpty(p.SKU) && p.SKU.ToLower().Contains(query))
            );
        }

        
        public async Task DeleteAsync(Product product)
        {
            _context.Products.Update(product);
            await _context.SaveChangesAsync();
        }

        public async Task<(IEnumerable<Product>, int)> GetPagedAsync(
            Guid storeId,
            int page,
            int pageSize,
            string? search,
            decimal? minPrice,
            decimal? maxPrice,
            string? sortBy)
            {
                var query = _context.Products
                    .Include(p => p.Tax)
                    .Where(p => p.StoreId == storeId && p.IsActive)
                    .AsQueryable();

            // 🔍 SEARCH
            if (!string.IsNullOrWhiteSpace(search))
            {
                search = search.ToLower();

                query = query.Where(p =>
                    p.Name.ToLower().Contains(search) ||
                    p.SKU.ToLower().Contains(search) ||
                    p.Barcode.Contains(search)
                );
            }

            // 💰 PRICE FILTER
            if (minPrice.HasValue)
                query = query.Where(p => p.SellingPrice >= minPrice.Value);

            if (maxPrice.HasValue)
                query = query.Where(p => p.SellingPrice <= maxPrice.Value);

            // 🔃 SORTING
            query = sortBy switch
            {
                "price_asc" => query.OrderBy(p => p.SellingPrice),
                "price_desc" => query.OrderByDescending(p => p.SellingPrice),
                "name_asc" => query.OrderBy(p => p.Name),
                "name_desc" => query.OrderByDescending(p => p.Name),
                _ => query.OrderBy(p => p.Name)
            };

            var totalCount = await query.CountAsync();

            var products = await query
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();

            return (products, totalCount);
        }
        // Get products by category
        public async Task<IEnumerable<Product>> GetByCategoryAsync(Guid categoryId, Guid storeId)
        {
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.CategoryId == categoryId && p.StoreId == storeId && p.IsActive)
                .ToListAsync();
        }

        // Get products with stock below threshold
        public async Task<IEnumerable<Product>> GetLowStockAsync(Guid storeId, int threshold)
        {
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.StoreId == storeId && p.IsActive && p.Stock > 0 && p.Stock <= threshold)
                .ToListAsync();
        }

        // Get products with zero stock
        public async Task<IEnumerable<Product>> GetOutOfStockAsync(Guid storeId)
        {
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.StoreId == storeId && p.IsActive && p.Stock == 0)
                .ToListAsync();
        }

        // Increase stock
        public async Task IncreaseStockAsync(Guid productId, int quantity)
        {
            var product = await _context.Products.FirstOrDefaultAsync(p => p.Id == productId && p.IsActive);
            if (product != null)
            {
                product.Stock += quantity;
                await _context.SaveChangesAsync();
            }
        }

        // Decrease stock
        public async Task DecreaseStockAsync(Guid productId, int quantity)
        {
            var product = await _context.Products.FirstOrDefaultAsync(p => p.Id == productId && p.IsActive);
            if (product != null && product.Stock >= quantity)
            {
                product.Stock -= quantity;
                await _context.SaveChangesAsync();
            }
        }

        // Bulk update stock
        public async Task BulkUpdateStockAsync(IEnumerable<(Guid productId, int quantity)> updates)
        {
            var productIds = updates.Select(u => u.productId).ToList();
            var products = await _context.Products.Where(p => productIds.Contains(p.Id) && p.IsActive).ToListAsync();
            foreach (var update in updates)
            {
                var product = products.FirstOrDefault(p => p.Id == update.productId);
                if (product != null)
                {
                    product.Stock = update.quantity;
                }
            }
            await _context.SaveChangesAsync();
        }

        // Stock summary (total, low, out-of-stock)
        public async Task<object> GetStockSummaryAsync(Guid storeId)
        {
            var total = await _context.Products.CountAsync(p => p.StoreId == storeId && p.IsActive);
            var low = await _context.Products.CountAsync(p => p.StoreId == storeId && p.IsActive && p.Stock > 0 && p.Stock <= 5);
            var outOfStock = await _context.Products.CountAsync(p => p.StoreId == storeId && p.IsActive && p.Stock == 0);
            return new { total, low, outOfStock };
        }

        // Top selling (stub: returns top by stock reduction, real impl would use sales data)
        public async Task<IEnumerable<Product>> GetTopSellingAsync(Guid storeId, int count)
        {
            // Placeholder: returns products with lowest stock (simulate high sales)
            return await _context.Products
                .AsNoTracking()
                .Where(p => p.StoreId == storeId && p.IsActive)
                .OrderBy(p => p.Stock)
                .Take(count)
                .ToListAsync();
        }

        // CATEGORY METHODS
        public async Task<IEnumerable<Category>> GetAllCategoriesAsync(Guid storeId)
        {
            return await _context.Categories.Where(c => c.StoreId == storeId).ToListAsync();
        }

        public async Task<Category?> GetCategoryByIdAsync(Guid id)
        {
            return await _context.Categories.FindAsync(id);
        }

        public async Task<Category> CreateCategoryAsync(Category category)
        {
            category.Id = Guid.NewGuid();
            _context.Categories.Add(category);
            await _context.SaveChangesAsync();
            return category;
        }

        public async Task<Category?> UpdateCategoryAsync(Guid id, Category update)
        {
            var category = await _context.Categories.FindAsync(id);
            if (category == null) return null;
            category.Name = update.Name;
            await _context.SaveChangesAsync();
            return category;
        }

        public async Task<bool> DeleteCategoryAsync(Guid id)
        {
            var category = await _context.Categories.FindAsync(id);
            if (category == null) return false;
            _context.Categories.Remove(category);
            await _context.SaveChangesAsync();
            return true;
        }

        // LOOKUP METHOD
        public async Task<IEnumerable<Product>> LookupAsync(Guid storeId, string query)
        {
            if (string.IsNullOrWhiteSpace(query))
                return Enumerable.Empty<Product>();
            var q = query.Trim().ToLower();
            return await _context.Products
                .Where(p => p.StoreId == storeId && p.IsActive &&
                    (p.Name.ToLower().Contains(q) ||
                     p.SKU.ToLower().Contains(q) ||
                     p.Barcode.ToLower().Contains(q)))
                .OrderBy(p => p.Name)
                .Take(20)
                .ToListAsync();
        }
    }
}