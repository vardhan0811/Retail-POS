using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using ProductService.DTOs;
using ProductService.Entities;
using ProductService.Services;

namespace ProductService.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    [Authorize]
    public class ProductController : ControllerBase
    {
        private readonly IProductService _productService;

        public ProductController(IProductService productService)
        {
            _productService = productService;
        }

        // ---------------- CREATE ----------------
        [Authorize(Policy = "CREATE_PRODUCT")]
        [HttpPost]
        public async Task<IActionResult> Create([FromBody] CreateProductRequest request)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            var product = await _productService.CreateProductAsync(request);

            return Ok(new ApiResponse<Product>
            {
                Message = "Product created successfully",
                Success = true,
                Data = product
            });
        }

        // ---------------- READ (PAGED) ----------------
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet]
        public async Task<IActionResult> GetAll(
            [FromQuery] Guid storeId,
            int page = 1,
            int pageSize = 20,
            string? search = null,
            decimal? minPrice = null,
            decimal? maxPrice = null,
            string? sortBy = null)
        {
            var result = await _productService.GetPagedAsync(
                storeId, page, pageSize, search, minPrice, maxPrice, sortBy);

            return Ok(new ApiResponse<PagedResult<Product>>
            {
                Message = "Products fetched successfully",
                Success = true,
                Data = result
            });
        }

        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("{id}")]
        public async Task<IActionResult> GetById(Guid id)
        {
            var product = await _productService.GetByIdAsync(id);
            if (product == null)
                return NotFound(new ApiResponse<Product>
                {
                    Message = "Product not found",
                    Success = false,
                    Data = null
                });
            return Ok(new ApiResponse<Product>
            {
                Message = "Product fetched successfully",
                Success = true,
                Data = product
            });
        }

        // ---------------- UPDATE ----------------
        [Authorize(Policy = "UPDATE_PRODUCT")]
        [HttpPut("{id}")]
        public async Task<IActionResult> Update(Guid id, [FromBody] UpdateProductRequest request)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            try
            {
                await _productService.UpdateAsync(id, request);
            }
            catch (Middleware.NotFoundException ex)
            {
                return NotFound(new ApiResponse<object>
                {
                    Message = ex.Message,
                    Success = false,
                    Data = null
                });
            }
            catch (Middleware.BusinessException ex)
            {
                return BadRequest(new ApiResponse<object>
                {
                    Message = ex.Message,
                    Success = false,
                    Data = null
                });
            }

            return Ok(new ApiResponse<CommandResultDto>
            {
                Message = "Product updated successfully",
                Success = true,
                Data = new CommandResultDto { Action = "update-product", ResourceId = id }
            });
        }

        // ---------------- DELETE ----------------
        [Authorize(Policy = "DELETE_PRODUCT")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(Guid id)
        {
            await _productService.DeleteAsync(id);

            return Ok(new ApiResponse<CommandResultDto>
            {
                Message = "Product deleted successfully",
                Success = true,
                Data = new CommandResultDto { Action = "delete-product", ResourceId = id }
            });
        }

        // ---------------- SEARCH ----------------
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("search")]
        public async Task<IActionResult> Search([FromQuery] string query, [FromQuery] Guid storeId)
        {
            var products = await _productService.SearchAsync(query, storeId);

            return Ok(new ApiResponse<IEnumerable<Product>>
            {
                Message = "Products search completed",
                Success = true,
                Data = products
            });
        }

        // ---------------- FILTERS ----------------
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("by-category/{categoryId}")]
        public async Task<IActionResult> GetByCategory(Guid categoryId, [FromQuery] Guid storeId)
        {
            var products = await _productService.GetByCategoryAsync(categoryId, storeId);

            return Ok(new ApiResponse<IEnumerable<Product>>
            {
                Message = "Products by category fetched successfully",
                Success = true,
                Data = products
            });
        }

        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("low-stock")]
        public async Task<IActionResult> GetLowStock([FromQuery] Guid storeId, int threshold = 5)
        {
            var products = await _productService.GetLowStockAsync(storeId, threshold);

            return Ok(new ApiResponse<IEnumerable<Product>>
            {
                Message = "Low stock products fetched successfully",
                Success = true,
                Data = products
            });
        }

        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("out-of-stock")]
        public async Task<IActionResult> GetOutOfStock([FromQuery] Guid storeId)
        {
            var products = await _productService.GetOutOfStockAsync(storeId);

            return Ok(new ApiResponse<IEnumerable<Product>>
            {
                Message = "Out of stock products fetched successfully",
                Success = true,
                Data = products
            });
        }

        // ---------------- STOCK ----------------
        [Authorize(Policy = "UPDATE_PRODUCT")]
        [HttpPost("{id}/increase-stock")]
        public async Task<IActionResult> IncreaseStock(Guid id, [FromBody] UpdateStockRequest request)
        {
            await _productService.IncreaseStockAsync(id, request.Quantity);

            return Ok(new ApiResponse<CommandResultDto>
            {
                Message = "Stock increased successfully",
                Success = true,
                Data = new CommandResultDto { Action = "increase-stock", ResourceId = id }
            });
        }

        [Authorize(Policy = "UPDATE_PRODUCT")]
        [HttpPost("{id}/decrease-stock")]
        public async Task<IActionResult> DecreaseStock(Guid id, [FromBody] UpdateStockRequest request)
        {
            await _productService.DecreaseStockAsync(id, request.Quantity);

            return Ok(new ApiResponse<CommandResultDto>
            {
                Message = "Stock decreased successfully",
                Success = true,
                Data = new CommandResultDto { Action = "decrease-stock", ResourceId = id }
            });
        }

        [Authorize(Policy = "UPDATE_PRODUCT")]
        [HttpPost("bulk-update-stock")]
        public async Task<IActionResult> BulkUpdateStock([FromBody] List<StockUpdateItem> updates)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            await _productService.BulkUpdateStockAsync(updates);

            return Ok(new ApiResponse<CommandResultDto>
            {
                Message = "Bulk stock update successful",
                Success = true,
                Data = new CommandResultDto { Action = "bulk-update-stock" }
            });
        }

        // ---------------- ANALYTICS ----------------
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("stock-summary")]
        public async Task<IActionResult> GetStockSummary([FromQuery] Guid storeId)
        {
            var summary = await _productService.GetStockSummaryAsync(storeId);

            return Ok(new ApiResponse<StockSummaryDto>
            {
                Message = "Stock summary fetched successfully",
                Success = true,
                Data = summary
            });
        }

        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("top-selling")]
        public async Task<IActionResult> GetTopSelling([FromQuery] Guid storeId, int count = 10)
        {
            var products = await _productService.GetTopSellingAsync(storeId, count);

            return Ok(new ApiResponse<IEnumerable<Product>>
            {
                Message = "Top selling products fetched successfully",
                Success = true,
                Data = products
            });
        }

        // ---------------- CATEGORY ----------------
        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("categories")]
        public async Task<IActionResult> GetCategories([FromQuery] Guid storeId)
        {
            var categories = await _productService.GetAllCategoriesAsync(storeId);

            return Ok(new ApiResponse<IEnumerable<Category>>
            {
                Message = "Categories fetched successfully",
                Success = true,
                Data = categories
            });
        }

        [Authorize(Policy = "VIEW_PRODUCT")]
        [HttpGet("categories/{id}")]
        public async Task<IActionResult> GetCategory(Guid id)
        {
            var category = await _productService.GetCategoryByIdAsync(id);

            return Ok(new ApiResponse<Category?>
            {
                Message = "Category fetched successfully",
                Success = true,
                Data = category
            });
        }

        [Authorize(Policy = "CREATE_PRODUCT")]
        [HttpPost("categories")]
        public async Task<IActionResult> CreateCategory([FromBody] CreateCategoryRequest request)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            var created = await _productService.CreateCategoryAsync(request);

            return Ok(new ApiResponse<Category>
            {
                Message = "Category created successfully",
                Success = true,
                Data = created
            });
        }

        [Authorize(Policy = "UPDATE_PRODUCT")]
        [HttpPut("categories/{id}")]
        public async Task<IActionResult> UpdateCategory(Guid id, [FromBody] UpdateCategoryRequest request)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            var updated = await _productService.UpdateCategoryAsync(id, request);

            return Ok(new ApiResponse<Category?>
            {
                Message = "Category updated successfully",
                Success = true,
                Data = updated
            });
        }

        [Authorize(Policy = "DELETE_PRODUCT")]
        [HttpDelete("categories/{id}")]
        public async Task<IActionResult> DeleteCategory(Guid id)
        {
            var deleted = await _productService.DeleteCategoryAsync(id);

            return Ok(new ApiResponse<bool>
            {
                Message = "Category deleted successfully",
                Success = true,
                Data = deleted
            });
        }
    }
}