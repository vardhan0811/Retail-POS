using AdminService.DTOs;
using AdminService.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace AdminService.Controllers
{
    [ApiController]
    [Route("api/admin/stores")]
    public class StoreController : ControllerBase
    {
        private readonly IStoreService _service;

        public StoreController(IStoreService service)
        {
            _service = service;
        }

        [Authorize(Policy = "MANAGE_USERS")]
        [HttpGet]
        public async Task<IActionResult> GetAllStores([FromQuery] bool? isActive = null, [FromQuery] string? search = null, [FromQuery] int page = 1, [FromQuery] int pageSize = 20)
        {
            var stores = await _service.GetPagedAsync(isActive, search, page, pageSize);
            return Ok(new ApiResponse<PagedResult<StoreDto>>
            {
                Success = true,
                Message = "Stores fetched successfully",
                Data = stores
            });
        }

        [Authorize(Policy = "MANAGE_USERS")]
        [HttpGet("{id}")]
        public async Task<IActionResult> GetById(Guid id)
        {
            var store = await _service.GetByIdAsync(id);
            if (store == null)
                return NotFound(new ApiResponse<StoreDto?>
                {
                    Success = false,
                    Message = "Store not found",
                    Data = null
                });

            return Ok(new ApiResponse<StoreDto>
            {
                Success = true,
                Message = "Store fetched successfully",
                Data = store
            });
        }

        [Authorize(Policy = "MANAGE_USERS")]
        [HttpPost]
        public async Task<IActionResult> Create([FromBody] CreateStoreRequest request)
        {
            if (!ModelState.IsValid)
                return BadRequest(new ApiResponse<object> { Success = false, Message = "Invalid request", Data = ModelState });

            var created = await _service.CreateAsync(request);
            return Ok(new ApiResponse<StoreDto>
            {
                Success = true,
                Message = "Store created successfully",
                Data = created
            });
        }

        [Authorize(Policy = "MANAGE_USERS")]
        [HttpPut("{id}")]
        public async Task<IActionResult> Update(Guid id, [FromBody] UpdateStoreRequest request)
        {
            if (!ModelState.IsValid)
                return BadRequest(new ApiResponse<object> { Success = false, Message = "Invalid request", Data = ModelState });

            var updated = await _service.UpdateAsync(id, request);
            return Ok(new ApiResponse<StoreDto>
            {
                Success = true,
                Message = "Store updated successfully",
                Data = updated
            });
        }

        [Authorize(Policy = "MANAGE_USERS")]
        [HttpDelete("{id}")]
        public async Task<IActionResult> Delete(Guid id)
        {
            await _service.DeleteAsync(id);
            return Ok(new ApiResponse<object>
            {
                Success = true,
                Message = "Store deleted successfully",
                Data = null
            });
        }
    }
}
