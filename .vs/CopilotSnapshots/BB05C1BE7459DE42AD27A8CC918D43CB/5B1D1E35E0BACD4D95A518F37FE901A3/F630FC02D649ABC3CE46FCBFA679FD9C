            var payments = await _repository.GetPaymentsByBillIdAsync(billId);
            return payments.Select(p => new PaymentDto
            {
                Id = p.Id,
                BillId = p.BillId,
                Amount = p.Amount,
                Method = p.Method,
                Status = p.Status,
                TransactionReference = p.TransactionReference,
                CreatedAt = p.CreatedAt
            });
        }
       

